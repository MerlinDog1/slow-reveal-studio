# Browser-safe canonical origin. Use HTTPS for live payments.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
# Keep prototype and preview deployments out of search; requires a clean HTTPS origin.
PUBLIC_SITE_INDEXABLE=false

# No service credentials are needed for the local lab or local guest design saves.
# Local files are private under .data (gitignored), never public/. Disable on cloud hosts.
STUDIO_DATA_DIR=.data
ALLOW_LOCAL_DEVELOPMENT_STORAGE=false

# Optional explicit loopback-only development/QA access; never enable on a public host.
ALLOW_LOCAL_ADMIN_TOKEN=false
# Generate a unique token with at least 32 base64url characters for local use only.
ADMIN_API_TOKEN=
# Independent random 32+ character secrets. Never reuse the admin token.
RATE_LIMIT_SECRET=
CRON_SECRET=
# JSON keyring of independent 32+ character random secrets; keep prior IDs when rotating.
# Example structure only: {"v1":"REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS"}
ORDER_ACCESS_KEYS=
ORDER_ACCESS_KEY_ID=v1

# Server-only database credential; apply supabase/migrations first.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Provision Auth users and active reviewer/operator rows in studio_admin_users manually.
# No public registration or automatic administrator grants exist in this app.
SUPABASE_ADMIN_AUTH_ENABLED=false
# Browser-safe credentials for the SAME Supabase project. Never put a service-role/secret key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# R2 bucket must have r2.dev and public/custom-domain access disabled.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Live checkout remains closed until ALL gates and the database catalogue are approved.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
LIVE_CHECKOUT_ENABLED=false
PHYSICAL_VALIDATION_APPROVED=false
# Opt in to all six active preview modes on a hosted prototype. Requires checkout explicitly
# false; this does not approve private customer designs, physical kits or payment collection.
PUBLIC_PROTOTYPE_MODES_ENABLED=false
# Customer designs require the physical flag above plus this allowlist for alternatives.
# Public previews use the same policy unless the prototype option above is enabled.
# Rebuild/redeploy after changing mode flags (static lab routes).
# Local development keeps all six active labs available without approving sales.
PHYSICALLY_VALIDATED_MODES=dots

# A signed-off live catalogue uses prototype:false in studio_catalogue, after cost/tax review.
# Test Stripe webhooks via the Stripe CLI; do not enable live mode just to test the UI.
